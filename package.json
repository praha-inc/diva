{
  "name": "@praha/diva",
  "version": "1.1.0",
  "description": "Diva, short for “Dependency Injection Value,” is a lightweight and type-safe DI library designed for TypeScript.",
  "keywords": [
    "javascript",
    "typescript",
    "dependency",
    "injection",
    "di"
  ],
  "homepage": "https://github.com/praha-inc/diva/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/praha-inc/diva/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praha-inc/diva.git"
  },
  "license": "MIT",
  "author": "PrAha, Inc.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./test": {
      "require": {
        "types": "./dist/cjs/test/index.d.cts",
        "default": "./dist/cjs/test/index.cjs"
      },
      "import": {
        "types": "./dist/esm/test/index.d.ts",
        "default": "./dist/esm/test/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.cts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rslib build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "oxlint",
    "lint:type": "tsc --noEmit",
    "version": "changeset",
    "version:apply": "changeset version",
    "version:publish": "changeset publish",
    "version:prepublish": "pkg-pr-new publish --pnpm --compact"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "2.31.1",
    "@praha/oxlint-config-standard": "1.0.0",
    "@rslib/core": "0.23.2",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.9.5",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "pkg-pr-new": "0.0.88",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "provenance": true
  }
}
